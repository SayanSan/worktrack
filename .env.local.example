# From your Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server-only, never expose to the browser.
# Used to invite/create team member accounts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# From resend.com → API Keys. Used to email someone when a task is assigned to them.
# Task-assignment emails are skipped (not an error) if this is unset.
RESEND_API_KEY=your-resend-api-key

# Optional: a verified sender, e.g. "WorkTrack <notifications@yourdomain.com>".
# Without your own verified domain on Resend, leave this unset — it falls back to
# Resend's shared sandbox sender, which only delivers to the email on your Resend account.
RESEND_FROM_EMAIL=
