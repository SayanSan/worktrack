# From your Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key (Project Settings → API). Server-side only — keep it secret and
# never expose it to the browser. Only used by the optional `npm run seed` script.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SMTP for task-assignment emails (any provider: Mailjet, Brevo, etc.).
# Emails are skipped (not an error) if SMTP_HOST/USER/PASS are unset.
# Mailjet example: host in-v3.mailjet.com, USER = API Key, PASS = Secret Key.
# SMTP_FROM must be a sender address the provider has verified.
SMTP_HOST=in-v3.mailjet.com
SMTP_PORT=587
SMTP_USER=your-mailjet-api-key
SMTP_PASS=your-mailjet-secret-key
SMTP_FROM=you@yourverifieddomain.com
