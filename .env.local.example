# From your Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key (Project Settings → API). Server-side only — keep it secret and
# never expose it to the browser. Only used by the optional `npm run seed` script.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# A Gmail or Google Workspace mailbox used to send task-assignment emails.
# GMAIL_APP_PASSWORD is a 16-character app password (myaccount.google.com/apppasswords),
# NOT the account's real password. Requires 2-Step Verification on that account.
# Task-assignment emails are skipped (not an error) if these are unset.
GMAIL_USER=you@yourdomain.com
GMAIL_APP_PASSWORD=your-16-char-app-password
